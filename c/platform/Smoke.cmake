file(MAKE_DIRECTORY "${TEST_DIR}")
set(target "${TEST_DIR}/test.dat")
file(REMOVE "${target}")
function(run expected)
  execute_process(COMMAND "${SPIT}" ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
  if(expected STREQUAL "pass")
    if(NOT rc EQUAL 0)
      message(FATAL_ERROR "Command failed (${rc}): ${ARGN}\n${out}\n${err}")
    endif()
  elseif(rc EQUAL 0)
    message(FATAL_ERROR "Invalid command succeeded: ${ARGN}")
  endif()
endfunction()
run(pass -h)
run(pass -f "${target}" -G 1MiB -c ws1k4q1x1 -v -R 42)
file(SIZE "${target}" size)
if(NOT size EQUAL 1048576)
  message(FATAL_ERROR "Wrong target size: ${size}")
endif()
file(SHA256 "${target}" before)
run(pass -f "${target}" -c rs1k4q1x1)
run(fail -f "${target}" -G 2MiB -c rs1k4q1x1)
run(fail -f "${target}" -c rs1k4q8x1)
run(fail -f "${target}" -c rs1k4q1 -t nan)
run(fail -f "${target}" -c rs1k4q1j-1)
file(SHA256 "${target}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Read-only or rejected job changed the target")
endif()
file(READ "${target}" prefix LIMIT 524288 HEX)
run(pass -f "${target}" -G 512KiB-1MiB -c ws1k4q1x1 -v -R 43)
file(READ "${target}" newprefix LIMIT 524288 HEX)
if(NOT prefix STREQUAL newprefix)
  message(FATAL_ERROR "Write escaped its range")
endif()
run(fail -f "${target}" -G 2MiB -c ws1k4q1x1)
run(pass --recreate -f "${target}" -G 2MiB -c ws1k4q1P8X1 -v)
file(SIZE "${target}" size)
if(NOT size EQUAL 2097152)
  message(FATAL_ERROR "Explicit recreation failed")
endif()
file(REMOVE "${target}")
message(STATUS "Native file-I/O, verification, bounds, and argument tests passed")
